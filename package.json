{
  "name": "@ofzza/showroom",
  "version": "0.1.0",
  "description": "Build a showroom for a repository: its documentation, enriched by showcases.",
  "keywords": [
    "typescript",
    "cli",
    "showroom",
    "showcase",
    "documentation"
  ],
  "homepage": "https://github.com/ofzza/showroom#readme",
  "bugs": {
    "url": "https://github.com/ofzza/showroom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofzza/showroom.git"
  },
  "license": "MIT",
  "author": "ofzza",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "showroom": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json && npm run copy-app",
    "dev": "npm run copy-app && tsc -p tsconfig.build.json --watch",
    "copy-app": "node -e \"require('fs').cpSync('src/app/index.html', 'dist/app/index.html')\"",
    "start": "node dist/cli/bin.js",
    "ci": "npm-run-all ci:*",
    "ci:build": "tsc -p tsconfig.build.json",
    "ci:showroom": "node dist/cli/bin.js check --showcases --quiet",
    "ci:eslint": "eslint src",
    "ci:prettier": "prettier --check src",
    "ci:test-unit": "npm-run-all test:unit",
    "ci:test-integration": "npm-run-all test:integration",
    "ci:test-e2e": "npm-run-all test:e2e",
    "ci:test-serve": "npm-run-all test:serve",
    "test": "npm-run-all test:*",
    "test:unit": "vitest run --passWithNoTests --project unit",
    "test:integration": "vitest run --passWithNoTests --project integration",
    "test:e2e": "vitest run --passWithNoTests --project e2e",
    "test:serve": "vitest run --passWithNoTests --project serve",
    "prepare": "npm run build",
    "prepublishOnly": "npm run ci"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-icons": "^2.0.345",
    "ignore": "^7.0.14",
    "json5": "^2.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vite": "^8.3.7"
  }
}
